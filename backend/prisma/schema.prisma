generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
  enable_experimental_decimal = true
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum Role {
  RENTER // Арендатор
  LESSER // Арендодатель
}

enum TimeMeasurement {
  HOUR
  DAY
  MONTH
}

enum Availability {
  FREE        // Свободно
  BUSY        // Занято
  TEMP_CLOSED // Закрыто на некоторое время
}

enum BookingStatus {
  OPEN      // Открыто
  CLOSED    // Закрыто
  CANCELLED // Расторгнуто
}

enum NotificationStatus {
  ERROR
  SUCCESS
  INFO
}

// ==================== MODELS ====================

model User {
  user_id        Int       @id @default(autoincrement())
  role           Role
  name           String
  surname        String?
  patronymic     String?
  email          String    @unique
  password_hash  String
  phone_number   String?
  is_blacklisted Boolean   @default(false)
  is_blocked     Boolean   @default(false)
  rating         Decimal?  @db.Decimal(3, 2)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  // Relations
  rentals              Rental[]         @relation("OwnerRentals")
  bookings_as_owner    Booking[]        @relation("BookingOwner")
  bookings_as_booker   Booking[]        @relation("BookingBooker")
  reviews_written      ReviewOfRental[] @relation("ReviewAuthor")
  reviews_of_user      ReviewOfUser[]   @relation("ReviewedUser")
  reviews_about_me     ReviewOfUser[]   @relation("ReviewAuthorUser")
  favorites            Favorite[]
  blacklists_as_lesser BlackList[]      @relation("BlackListLesser")
  blacklists_as_renter BlackList[]      @relation("BlackListRenter")
  notifications        Notification[]  @relation("NotificationOwner")

  @@map("users")
}

model Category {
  category_id Int      @id @default(autoincrement())
  name        String   @unique
  desc        String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  rentals Rental[]

  @@map("categories")
}

model Rental {
  rental_id        Int             @id @default(autoincrement())
  owner_id         Int
  category_id      Int?
  title            String
  address          String
  area             Decimal         @db.Decimal(10, 2)
  price            Decimal         @db.Decimal(12, 2)
  time_measurement TimeMeasurement @default(HOUR)
  photo_url        String?
  availability     Availability    @default(FREE)
  desc             String?
  amount_of_people Int             @default(1)
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt

  // Relations
  owner     User             @relation("OwnerRentals", fields: [owner_id], references: [user_id])
  category  Category?        @relation(fields: [category_id], references: [category_id])
  bookings  Booking[]
  reviews   ReviewOfRental[]
  favorites Favorite[]

  @@map("rentals")
}

model Booking {
  booking_id  Int           @id @default(autoincrement())
  owner_id    Int           // Арендодатель
  booker_id   Int           // Арендатор
  rental_id   Int
  start_date  DateTime
  end_date    DateTime
  status      BookingStatus @default(OPEN)
  total_price Decimal       @db.Decimal(12, 2)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt

  // Relations
  owner  User   @relation("BookingOwner", fields: [owner_id], references: [user_id])
  booker User   @relation("BookingBooker", fields: [booker_id], references: [user_id])
  rental Rental @relation(fields: [rental_id], references: [rental_id])

  @@map("bookings")
}

model ReviewOfRental {
  review_id  Int      @id @default(autoincrement())
  rental_id  Int
  author_id  Int
  rating     Int // 1-5
  comment    String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  rental Rental @relation(fields: [rental_id], references: [rental_id])
  author User   @relation("ReviewAuthor", fields: [author_id], references: [user_id])

  @@map("reviews_of_rental")
}

model ReviewOfUser {
  review_id  Int      @id @default(autoincrement())
  author_id  Int
  user_id    Int // кого оценивают
  rating     Int // 1-5
  comment    String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  author User @relation("ReviewAuthorUser", fields: [author_id], references: [user_id])
  user   User @relation("ReviewedUser", fields: [user_id], references: [user_id])

  @@map("reviews_of_user")
}

model Favorite {
  favorite_id Int @id @default(autoincrement())
  rental_id   Int
  user_id     Int

  rental Rental @relation(fields: [rental_id], references: [rental_id])
  user   User   @relation(fields: [user_id], references: [user_id])

  @@unique([user_id, rental_id])
  @@map("favorites")
}

model Fine {
  fine_id     Int      @id @default(autoincrement())
  fine_number String   @unique
  amount      Decimal  @db.Decimal(12, 2)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  black_lists BlackList[]

  @@map("fines")
}

model BlackList {
  black_list_id Int      @id @default(autoincrement())
  fine_id       Int?
  lesser_id     Int // кто добавил в ЧС
  renter_id     Int // кого добавили
  is_closed     Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  fine   Fine? @relation(fields: [fine_id], references: [fine_id])
  lesser User  @relation("BlackListLesser", fields: [lesser_id], references: [user_id])
  renter User  @relation("BlackListRenter", fields: [renter_id], references: [user_id])

  @@map("black_lists")
}

model Notification {
  notification_id Int                @id @default(autoincrement())
  owner_id        Int
  status          NotificationStatus @default(INFO)
  comment         String?
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt

  owner User @relation("NotificationOwner", fields: [owner_id], references: [user_id])

  @@map("notifications")
}
